# Build output
/apps/web/dist/
coverage/

# Test caches
.phpunit.result.cache
.phpunit.cache

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Never ignore the example env
!.env.example
