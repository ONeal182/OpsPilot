# OpsPilot Agent Runtime — environment example.
# Copy to .env for local host runs. The container gets these from the repo-root .env
# via docker-compose `env_file:`. No secrets in this file.

# --- RabbitMQ connection ---
# Either provide the discrete parts below (assembled into an amqp:// URL)...
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=opspilot
RABBITMQ_PASSWORD=opspilot
RABBITMQ_VHOST=/
# ...or override everything with a single URL (takes precedence if set):
# RABBITMQ_URL=amqp://opspilot:opspilot@localhost:5672/

# --- Messaging topology (shared with the Laravel side, see docs/contracts/messaging.md) ---
OPSPILOT_EXCHANGE=opspilot.events
OPSPILOT_ANALYSIS_QUEUE=agent.analysis.requested
OPSPILOT_ANALYSIS_ROUTING_KEY=agent.analysis.requested
OPSPILOT_DLX=opspilot.dlx
OPSPILOT_DLQ=agent.analysis.requested.dlq

# --- Agent driver selection ---
# fake  = deterministic offline driver (default, no credentials)
# claude = real Claude Agent SDK driver (requires ANTHROPIC_API_KEY)
AGENT_DRIVER=fake

# only for AGENT_DRIVER=claude, never commit
ANTHROPIC_API_KEY=
