APP_NAME=OpsPilot
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# APP_KEY is intentionally NOT set here. Compose injects this file into the PHP
# containers via `env_file:`, and Laravel's dotenv loader will not override a
# real (even empty) env var — so a blank APP_KEY here would shadow the generated
# key. Instead the key lives in apps/api/.env, written by `php artisan
# key:generate` during first-time setup (see README).

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=opspilot
DB_USERNAME=opspilot
DB_PASSWORD=opspilot
MYSQL_ROOT_PASSWORD=root

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=opspilot
RABBITMQ_PASSWORD=opspilot
RABBITMQ_VHOST=/

OPSPILOT_EXCHANGE=opspilot.events
OPSPILOT_ANALYSIS_QUEUE=agent.analysis.requested
OPSPILOT_ANALYSIS_ROUTING_KEY=agent.analysis.requested
OPSPILOT_DLX=opspilot.dlx
OPSPILOT_DLQ=agent.analysis.requested.dlq

AGENT_DRIVER=fake
# ANTHROPIC_API_KEY is ONLY needed when AGENT_DRIVER=claude. Never commit a real key.
ANTHROPIC_API_KEY=

NGINX_HOST_PORT=8080
MYSQL_HOST_PORT=33061
REDIS_HOST_PORT=63790
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
WEB_HOST_PORT=5173
VITE_API_URL=http://localhost:8080

WWWUSER=1000
WWWGROUP=1000
